#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Runs the /tmp age rules, but first excludes every /tmp path a running process
# holds open or uses as its working or root directory: systemd-tmpfiles only looks at
# timestamps, so a long-running job could otherwise lose files under its feet.
# Extra arguments (e.g. --dry-run) go to systemd-tmpfiles.
set -eu

case "${1:-}" in
	-h|--help)
		cat <<'EOF'
Usage: tmpcleaner [options]

Cleans /tmp using systemd-tmpfiles rules while protecting paths currently
in use by running processes.

Options:
  -h, --help       Show this help message and exit
  --print-rules    Print generated tmpfiles rules and exit
  --check PATH     Report whether an existing absolute /tmp path would be removed
                   Exit 0 if removed, 1 if kept, 2 for an invalid path or usage

Other arguments (such as --dry-run) are passed to systemd-tmpfiles.

Environment variables:
  TMPCLEANER_CONF           Path to configuration file
                            (default: /etc/tmpcleaner/tmpcleaner.conf)
  TMPCLEANER_AGE            Override duration on every d rule (e.g. 6h, 30m)
  TMPCLEANER_FULL_PERCENT   Threshold percentage of /tmp usage (1-100)
  TMPCLEANER_FULL_AGE       Age duration to use when /tmp usage meets or
                            exceeds TMPCLEANER_FULL_PERCENT
EOF
		exit 0
		;;
esac

check=
if [ "${1:-}" = --check ]; then
	[ "$#" -eq 2 ] || { echo "tmpcleaner: --check requires one absolute path under /tmp" >&2; exit 2; }
	case "$2" in
		/tmp/*) ;;
		*) echo "tmpcleaner: --check requires an absolute path under /tmp" >&2; exit 2 ;;
	esac
	check=$(realpath -e -s -- "$2" 2>/dev/null) || {
		echo "tmpcleaner: --check path does not exist: $2" >&2
		exit 2
	}
	case "$check" in
		/tmp/*) ;;
		*) echo "tmpcleaner: --check path must be under /tmp: $2" >&2; exit 2 ;;
	esac
fi

conf=${TMPCLEANER_CONF:-/etc/tmpcleaner/tmpcleaner.conf}
[ -r "$conf" ] || { echo "tmpcleaner: cannot read $conf" >&2; exit 1; }
# Check the user's own value before pressure mode may replace it.
if [ "${TMPCLEANER_AGE+x}" ]; then
	printf '%s\0' "$TMPCLEANER_AGE" | LC_ALL=C grep -zEq '^[0-9]+(us|ms|s|m|min|h|d|w)?$' || {
		echo "tmpcleaner: invalid TMPCLEANER_AGE: $TMPCLEANER_AGE" >&2
		exit 1
	}
fi
if [ "${TMPCLEANER_FULL_PERCENT+x}" ] && [ "${TMPCLEANER_FULL_AGE+x}" ]; then
	printf '%s\0' "$TMPCLEANER_FULL_PERCENT" | LC_ALL=C grep -zEq '^([1-9][0-9]?|100)$' || {
		echo "tmpcleaner: invalid TMPCLEANER_FULL_PERCENT: $TMPCLEANER_FULL_PERCENT" >&2
		exit 1
	}
	printf '%s\0' "$TMPCLEANER_FULL_AGE" | LC_ALL=C grep -zEq '^[0-9]+(us|ms|s|m|min|h|d|w)?$' || {
		echo "tmpcleaner: invalid TMPCLEANER_FULL_AGE: $TMPCLEANER_FULL_AGE" >&2
		exit 1
	}
	usage=$(df --output=pcent /tmp)
	usage=$(printf '%s\n' "$usage" | sed -n '2s/^[[:space:]]*\([0-9][0-9]*\)%$/\1/p')
	[ -n "$usage" ] || { echo "tmpcleaner: cannot read /tmp usage" >&2; exit 1; }
	if [ "$usage" -ge "$TMPCLEANER_FULL_PERCENT" ]; then
		TMPCLEANER_AGE=$TMPCLEANER_FULL_AGE
		echo "tmpcleaner: /tmp is $usage% full, using age $TMPCLEANER_AGE" >&2
	fi
fi

control_escapes=$(
	control=1
	while [ "$control" -le 31 ]; do
		printf 's/\\d%03d/\\\\x%02x/g\n' "$control" "$control"
		control=$((control + 1))
	done
	printf 's/\\d127/\\\\x7f/g\n'
)

# Targets of every process's exe, cwd, root and open fds, plus its memory-mapped files. One find, not a readlink per fd:
# a busy desktop has tens of thousands of fds. Translate bind-mount aliases
# using the mount table matching the target, but never exclude /tmp itself.
in_use() {
	find /proc/self/ns/mnt /proc/[0-9]*/ns/mnt /proc/[0-9]*/exe /proc/[0-9]*/cwd /proc/[0-9]*/root /proc/[0-9]*/fd -maxdepth 1 -type l -printf '%p\0%l\0' 2>/dev/null |
		LC_ALL=C awk '
		function decode(path) {
			gsub(/\\040/, " ", path)
			gsub(/\\011/, "\t", path)
			gsub(/\\012/, "\n", path)
			gsub(/\\134/, sprintf("%c", 92), path)
			return path
		}
		function under(path, dir) {
			return dir == "/" || path == dir || index(path, dir "/") == 1
		}
		function suffix(path, dir) {
			return dir == "/" ? path : substr(path, length(dir) + 1)
		}
		function containing(pid, path, n, best, longest) {
			for (n = 1; n <= count[pid]; n++) {
				if (under(path, point[pid, n]) && length(point[pid, n]) >= longest) {
					longest = length(point[pid, n])
					best = n
				}
			}
			return best
		}
		function near(pid, path, k) {
			for (k = 1; k <= ntmp[pid]; k++) if (under(path, point[pid, tmpidx[pid, k]])) return 1
			return 0
		}
		function mounts(pid, file, line, fields, n, saved) {
			if (pid in count) return
			count[pid] = 0
			file = "/proc/" pid "/mountinfo"
			saved = RS
			RS = "\n"
			while ((getline line < file) > 0) {
				split(line, fields)
				n = ++count[pid]
				dev[pid, n] = fields[3]
				root[pid, n] = decode(fields[4])
				point[pid, n] = decode(fields[5])
				if (dev[pid, n] == device) tmpidx[pid, ++ntmp[pid]] = n
			}
			close(file)
			RS = saved
		}
		BEGIN {
			mounts("self")
			n = containing("self", "/tmp")
			device = dev["self", n]
			tmp_root = root["self", n]
			tmp_root = (tmp_root == "/" ? "" : tmp_root) suffix("/tmp", point["self", n])
			if (tmp_root == "") tmp_root = "/"
			# The device was unknown while "self" was read; list its /tmp-device mounts now.
			for (n = 1; n <= count["self"]; n++)
				if (dev["self", n] == device) tmpidx["self", ++ntmp["self"]] = n
			# maps shows device numbers in hex; files on /tmp all carry this one.
			split(device, mm, ":")
			devhex = sprintf("%02x:%02x", mm[1], mm[2])
			# find prints NUL-terminated path/target pairs.
			RS = "\0"
		}
		function handle(pid, target, table, n, path) {
			if (substr(target, 1, 1) != "/" || device == "") return
			table = (namespace[pid] != "" && namespace[pid] == namespace["self"] ? "self" : pid)
			mounts(table)
			# Cheap pre-check: most targets lie on no mount of the /tmp filesystem.
			if (!near(table, target)) return
			n = containing(table, target)
			if (dev[table, n] != device) return
			path = (root[table, n] == "/" ? "" : root[table, n]) suffix(target, point[table, n])
			if (!under(path, tmp_root)) return
			path = "/tmp" suffix(path, tmp_root)
			gsub(/\/+/, "/", path)
			sub(/\/$/, "", path)
			if (path ~ /(^|\/)\.\.?($|\/)/) return
			if (index(path, "/tmp/") == 1 && length(path) > 5) printf "%s%c", path, 0
		}
		# Memory-mapped files come from the maps text: listing map_files makes the
		# kernel build an entry per mapping (tens of MB across all processes).
		function mapped(pid, file, line, path, seen, saved) {
			file = "/proc/" pid "/maps"
			saved = RS
			RS = "\n"
			while ((getline line < file) > 0) {
				if (!index(line, " " devhex " ")) continue
				if (!sub(/^[^ ]+ +[^ ]+ +[^ ]+ +[^ ]+ +[^ ]+ +/, "", line)) continue
				if (substr(line, 1, 1) != "/" || line in seen) continue
				seen[line] = 1
				path = line
				gsub(/\\012/, "\n", path)
				handle(pid, path)
			}
			close(file)
			RS = saved
		}
		NR % 2 { split($0, parts, "/"); pid = parts[3]; next }
		{
			if (parts[4] == "ns") {
				namespace[pid] = $0
				if (pid != "self") mapped(pid)
				next
			}
			handle(pid, $0)
		}'
}

rules() {
	if [ "${TMPCLEANER_AGE+x}" ]; then
		# Replace the duration of the age field, keeping any age-by letters.
		sed -E "/^d[[:space:]]/s/[[:space:]]+([abcmABCM]+:)?[^[:space:]]*[[:space:]]*\$/ \\1$TMPCLEANER_AGE/" "$conf"
	else
		cat "$conf"
	fi
	echo
	# File names are untrusted (any user can hold a file open), so each must
	# match only itself. NUL-separated, so a newline in a name cannot start a
	# new rule. tmpfiles treats a path with * ? [ as a glob: there, escape the
	# glob characters, or a file named "*" would exclude all of /tmp. Then
	# C-escape \ " and all control bytes for the quoted field and double % (specifier).
	in_use | sort -zu |
		sed -z -e '/[[*?]/s/[][*?\\]/\\&/g' -e 's/[\\"]/\\&/g' \
			-e "$control_escapes" -e 's/%/%%/g' -e 's/.*/x "&"/' | tr '\0' '\n'
}

if [ "${1:-}" = --print-rules ]; then
	rules
	exit 0
fi

if [ -n "$check" ]; then
	# 73: an unprivileged check cannot open root-only directories; the rest is valid.
	status=0
	preview=$(rules | systemd-tmpfiles --clean --dry-run - 2>&1) || status=$?
	if [ "$status" -ne 0 ] && [ "$status" -ne 73 ]; then
		printf '%s\n' "$preview" >&2
		exit "$status"
	fi
	if printf '%s\n' "$preview" | grep -Fxq -e "Would remove \"$check\"" -e "Would remove directory \"$check\""; then
		printf 'would be removed: %s\n' "$2"
		exit 0
	fi
	printf 'kept: %s\n' "$2"
	exit 1
fi

for arg do
	if [ "$arg" = --dry-run ]; then
		rules | systemd-tmpfiles --clean "$@" -
		exit $?
	fi
done

# Count what the run removes. "Removing directory" is logged before rmdir, which
# fails silently on a directory that still holds kept files, so attempted
# directories are listed and only those gone afterwards are counted.
# Keep the <N> level prefix only when stderr really is the journal stream.
journal=
[ -n "${JOURNAL_STREAM:-}" ] &&
	[ "$JOURNAL_STREAM" = "$(stat -L -c '%d:%i' /proc/self/fd/2 2>/dev/null)" ] && journal=1
attempted=$(mktemp)
removed_files=$(mktemp)
trap 'rm -f "$attempted" "$removed_files"' EXIT

# Keep stdout on fd 3 and the tmpfiles exit status on fd 4, outside the log pipe.
{
	status=$(
		exec 4>&1
		{
			rules | SYSTEMD_LOG_LEVEL=debug SYSTEMD_LOG_TARGET=console-prefixed \
				systemd-tmpfiles --clean "$@" - 2>&1 1>&3 && rc=0 || rc=$?
			printf '%s\n' "$rc" >&4
		} | LC_ALL=C awk -v journal="$journal" -v attempted="$attempted" -v removed_files="$removed_files" '
		{
			if (!match($0, /^<[0-9]+>/) || substr($0, 2, RLENGTH - 2) % 8 <= 6) {
				# journald turns the <N> prefix into the entry level; a terminal shows it raw.
				print (journal ? $0 : substr($0, RLENGTH + 1))
				next
			}
			message = substr($0, RLENGTH + 1)
			if (message ~ /^Removing "/) files++
			else if (message ~ /^Removing directory "/) {
				path = substr(message, 21)
				sub(/"$/, "", path)
				printf "%s%c", path, 0 > attempted
			}
		}
		END { print files + 0 > removed_files }
		' >&2
	)
} 3>&1
total=$(tr -cd '\000' < "$attempted" | wc -c)
# shellcheck disable=SC2185 # the start points come from the -files0-from list
left=$(find -files0-from "$attempted" -maxdepth 0 -printf . 2>/dev/null | wc -c)
echo "tmpcleaner: removed $(cat "$removed_files") files and $((total - left)) directories" >&2
exit "$status"
