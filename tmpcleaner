#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Runs the /tmp age rules, but first excludes every /tmp path a running process
# holds open or uses as its working or root directory: systemd-tmpfiles only looks at
# timestamps, so a long-running job could otherwise lose files under its feet.
# Only --dry-run and --prefix=PATH are passed through to systemd-tmpfiles to
# narrow what it applies; --exclude-prefix=PATH adds an exclusion for an
# absolute PATH and everything below it, and --exclude-from0=FILE adds one for
# every NUL-terminated path in FILE.
set -eu

previewing=0
case "${1:-}" in
	-h|--help|--print-rules|--print-in-use0|--print-holders0|--suggest-exclusions|--check|--check0) previewing=1 ;;
	*)
		for arg do
			[ "$arg" != --dry-run ] || previewing=1
		done
		;;
esac
scratch='' metrics_ready='' summary_files=0 summary_directories=0 counts_available=false
finish() {
	exit_status=$?
	trap - EXIT
	if [ "$previewing" = 0 ] && [ "${TMPCLEANER_SUMMARY:-}" = json ]; then
		if [ "$exit_status" -ne 0 ]; then
			summary_files=0 summary_directories=0 counts_available=false
		fi
		printf '{"tmpcleaner":"run","exit_status":%d,"removed_files":%d,"removed_directories":%d,"counts_available":%s}\n' \
			"$exit_status" "$summary_files" "$summary_directories" "$counts_available" >&2 || :
	fi
	if [ -n "$metrics_ready" ] && [ "$previewing" = 0 ] && [ -n "${TMPCLEANER_METRICS:-}" ]; then
		write_metrics || :
	fi
	[ -z "$scratch" ] || rm -rf "$scratch" || :
	exit "$exit_status"
}
trap finish EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

with_sources=
for arg do
	[ "$arg" != --with-sources ] || with_sources=1
done
if [ -n "$with_sources" ] && [ "${1:-}" != --print-rules ]; then
	echo 'tmpcleaner: --with-sources requires --print-rules' >&2
	exit 2
fi

case "${1:-}" in
	-h|--help)
		cat <<'EOF'
Usage: tmpcleaner [options]

Cleans /tmp using systemd-tmpfiles rules while protecting paths currently
in use by running processes.

Options:
  -h, --help       Show this help message and exit
  --print-rules    Print generated tmpfiles rules and exit
                   Accepts trailing --exclude-prefix=PATH and
                   --exclude-from0=FILE filters
                   Add --with-sources to label each rule's source file
                   (--print-rules only)
  --print-in-use0  Print unique in-use paths as NUL-separated records and exit
                   Standalone option; accepts no other arguments
  --print-holders0 Print in-use paths and holder PIDs as NUL-separated pairs
                   (PATH\0PIDS\0) and exit
                   Standalone option; accepts no other arguments
  --suggest-exclusions
                   Print candidate x exclusion rules for top-level /tmp entries
                   the next run would clean and exit
                   Accepts trailing --exclude-prefix=PATH and
                   --exclude-from0=FILE filters
  --check PATH     Report whether an existing absolute /tmp path would be removed
                   Accepts trailing --exclude-prefix=PATH and
                   --exclude-from0=FILE filters
                   Exit 0 if removed, 1 if kept (only), 2 for an error (invalid
                   path or usage, unreadable config, invalid TMPCLEANER_* value,
                   missing /proc, a failed in-use scan, or a systemd-tmpfiles
                   failure other than 73)
  --check0         Judge NUL-separated /tmp paths from stdin in one scan and
                   print removed\0PATH\0 or kept\0PATH\0 records
                   Accepts trailing --exclude-prefix=PATH and
                   --exclude-from0=FILE filters
                   Exit 0 if all removed, 1 if any kept, 2 for an error

Passed through to systemd-tmpfiles (any other argument is rejected with exit 2):
  --dry-run                Preview what would be removed without deleting
  --prefix=PATH            Only apply rules with the prefix PATH
  --exclude-prefix=PATH    Keep the absolute path PATH and everything below it
  --exclude-from0=FILE     Keep every NUL-terminated path in the absolute FILE as
                           --exclude-prefix=PATH does

A regular .tmpcleaner-keep file in /tmp/<dir> or /tmp/<dir>/<subdir> keeps that directory.
When the in-use scan fails, nothing is removed and every mode exits non-zero.

Environment variables:
  TMPCLEANER_CONF           Path to configuration file
                            (default: /etc/tmpcleaner/tmpcleaner.conf)
                            Drop-ins: <path>.d/*.conf, read after it in byte order
  TMPCLEANER_AGE            Override duration on every d and D rule
                            (e.g. 6h, 30m)
  TMPCLEANER_MARKER_AGE     Expire markers by modification age (default: never)
                            Whole minutes: m, min, h, d or w (e.g. 1h)
  TMPCLEANER_PROTECT_TMPDIR Set to 1 to protect live processes' TMPDIR directories
                            strictly below /tmp (default: off)
  TMPCLEANER_FULL_PERCENT   Threshold percentage of /tmp usage (1-100); the
                            larger of block and inode usage counts ('-' = 0).
                            If df fails or prints unexpected output, the run
                            aborts (exit 1, or 2 with --check)
  TMPCLEANER_FULL_AGE       Age duration to use when /tmp usage meets or
                            exceeds TMPCLEANER_FULL_PERCENT
  TMPCLEANER_LIST           Set to 1 to list removed paths with control bytes
                            and backslashes escaped, top for the top-10
                            per-entry breakdown, or nul for raw NUL-separated
                            paths on stdout (real runs only; default: off)
  TMPCLEANER_SUMMARY        Set to json for one JSON completion record on stderr
                            (real runs only; default: prose)
  TMPCLEANER_METRICS        Absolute path of a *.prom file for the
                            node_exporter textfile collector (real runs only)
EOF
		exit 0
		;;
esac

err_tag=
warn_tag=
if [ -n "${JOURNAL_STREAM:-}" ] &&
	[ "$JOURNAL_STREAM" = "$(stat -L -c '%d:%i' "/proc/$$/fd/2" 2>/dev/null)" ]; then
	err_tag='<3>'
	warn_tag='<4>'
fi

if [ "${1:-}" = --print-rules ]; then
	shift
	for arg do
		case "$arg" in
			--with-sources) ;;
			--exclude-prefix=/*|--exclude-from0=/*) ;;
			*) echo "${err_tag}tmpcleaner: unsupported argument: $arg" >&2; exit 2 ;;
		esac
	done
	set -- --print-rules "$@"
elif [ "${1:-}" = --suggest-exclusions ]; then
	shift
	for arg do
		case "$arg" in
			--exclude-prefix=/*|--exclude-from0=/*) ;;
			*) echo "${err_tag}tmpcleaner: unsupported argument: $arg" >&2; exit 2 ;;
		esac
	done
	set -- --suggest-exclusions "$@"
elif [ "${1:-}" != --check ] && [ "${1:-}" != --check0 ]; then
	for arg do
		case "$arg" in
			--dry-run|--prefix=?*|--exclude-prefix=/*|--exclude-from0=/*) ;;
			--print-in-use0|--print-holders0) [ "$#" -eq 1 ] || { echo "${err_tag}tmpcleaner: $arg accepts no other arguments" >&2; exit 2; } ;;
			*) echo "${err_tag}tmpcleaner: unsupported argument: $arg" >&2; exit 2 ;;
		esac
	done
fi

nl='
'
errstatus=1
check=
check0=
holders_file=
export_holders=
[ "${1:-}" != --print-holders0 ] || export_holders=1
canonicalize_check() {
	shown=$(printf '%s' "$requested" | LC_ALL=C tr '\001-\037\177' '[?*]')
	case "$requested" in
		/tmp/*) ;;
		*) echo "${err_tag}tmpcleaner: --check requires an absolute path under /tmp${check0:+: $shown}" >&2; exit 2 ;;
	esac
	# Resolve symlinked parent directories (the preview prints real paths) but
	# keep the last component itself, which systemd-tmpfiles handles as is.
	# The sentinel keeps trailing newlines that command substitution would strip.
	path=$requested
	while [ "$path" != / ] && [ "${path%/}" != "$path" ]; do path=${path%/}; done
	base=${path##*/}
	case "$base" in
		.|..) parent=$path base= ;;
		*) parent=${path%/*} ;;
	esac
	# realpath reports the same failure for a missing path and for an ancestor
	# the caller cannot search. Walk up to the deepest existing directory
	# (never above /tmp) and call an unsearchable one unreadable.
	check=$(realpath -e -- "${parent:-/}" 2>/dev/null && printf x) || {
		dir=${parent:-/}
		while [ ! -e "$dir" ] && [ "$dir" != /tmp ]; do
			dir=${dir%/*}
		done
		if [ -d "$dir" ] && [ ! -x "$dir" ]; then
			echo "${err_tag}tmpcleaner: --check cannot read $shown" >&2
			exit 2
		fi
		echo "${err_tag}tmpcleaner: --check path does not exist: $shown" >&2
		exit 2
	}
	check=${check%x}
	check=${check%"$nl"}
	[ -z "$base" ] || check=${check%/}/$base
	[ -e "$check" ] || [ -L "$check" ] || {
		if [ -d "${check%/*}" ] && [ ! -x "${check%/*}" ]; then
			echo "${err_tag}tmpcleaner: --check cannot read $shown" >&2
			exit 2
		fi
		echo "${err_tag}tmpcleaner: --check path does not exist: $shown" >&2
		exit 2
	}
	case "$check" in
		*"$nl"*|*"$cr"*) echo "${err_tag}tmpcleaner: --check cannot match a path that contains a newline or carriage return${check0:+: $shown}" >&2; exit 2 ;;
	esac
	case "$check" in
		/tmp/*) ;;
		*) echo "${err_tag}tmpcleaner: --check path must be under /tmp: $shown" >&2; exit 2 ;;
	esac
}
if [ "${1:-}" = --check ]; then
	errstatus=2
	cr=$(printf '\r')
	[ "$#" -ge 2 ] || { echo "${err_tag}tmpcleaner: --check requires one absolute path under /tmp" >&2; exit 2; }
	requested=$2
	shift 2
	for arg do
		case "$arg" in
			--exclude-prefix=/*|--exclude-from0=/*) ;;
			*) echo "${err_tag}tmpcleaner: unsupported argument: $arg" >&2; exit 2 ;;
		esac
	done
	canonicalize_check
elif [ "${1:-}" = --check0 ]; then
	errstatus=2
	cr=$(printf '\r')
	check0=1
	shift
	for arg do
		case "$arg" in
			--exclude-prefix=/*|--exclude-from0=/*) ;;
			*) echo "${err_tag}tmpcleaner: unsupported argument: $arg" >&2; exit 2 ;;
		esac
	done
fi

case "${TMPCLEANER_SUMMARY:-}" in
	''|json) ;;
	*) echo "${err_tag}tmpcleaner: invalid TMPCLEANER_SUMMARY (expected json or empty)" >&2; exit "$errstatus" ;;
esac
case "${TMPCLEANER_METRICS:-}" in
	'') ;;
	/?*.prom)
		case "$TMPCLEANER_METRICS" in
			/.prom|*/.prom|*"$nl"*) echo "${err_tag}tmpcleaner: invalid TMPCLEANER_METRICS (expected absolute *.prom path)" >&2; exit "$errstatus" ;;
		esac
		;;
	*) echo "${err_tag}tmpcleaner: invalid TMPCLEANER_METRICS (expected absolute *.prom path)" >&2; exit "$errstatus" ;;
esac
case "${TMPCLEANER_PROTECT_TMPDIR:-}" in
	''|1) ;;
	*) echo "${err_tag}tmpcleaner: invalid TMPCLEANER_PROTECT_TMPDIR (expected 1 or empty)" >&2; exit "$errstatus" ;;
esac
write_metrics() {
	mtmp=
	metric_duration=$(START=$metric_started LC_ALL=C awk '
		NR == 1 { finish = $1 }
		END {
			start = ENVIRON["START"]
			if (NR != 1 || start !~ /^[0-9]+([.][0-9]+)?$/ || finish !~ /^[0-9]+([.][0-9]+)?$/ || finish + 0 < start + 0) exit 1
			elapsed = finish - start
			formatted = sprintf("%.2f", elapsed)
			if (formatted !~ /^[0-9]+[.][0-9][0-9]$/) exit 1
			print formatted
		}' /proc/uptime 2>/dev/null) || metric_duration=NaN
	mdir=${TMPCLEANER_METRICS%/*}
	# A metrics failure is logged, never turned into the run's exit status.
	if [ ! -d "$TMPCLEANER_METRICS" ] && now=$(date +%s 2>/dev/null) && mtmp=$(mktemp "${mdir:-/}/.tmpcleaner.XXXXXX" 2>/dev/null) && {
		last_success=0
		if [ "$exit_status" = 0 ]; then
			last_success=$now
		elif [ ! -L "$TMPCLEANER_METRICS" ] && [ -f "$TMPCLEANER_METRICS" ]; then
			prev_success=$(LC_ALL=C awk '/^tmpcleaner_last_success_timestamp_seconds [0-9]+$/ { print $2; exit }' "$TMPCLEANER_METRICS" 2>/dev/null) || prev_success=
			case "$prev_success" in
				*[!0-9]*|'') ;;
				*) last_success=$prev_success ;;
			esac
		fi
		cat > "$mtmp" <<EOF && chmod a+r "$mtmp" && mv -fT -- "$mtmp" "$TMPCLEANER_METRICS"
# HELP tmpcleaner_removed_files Number of files removed in the last run.
# TYPE tmpcleaner_removed_files gauge
tmpcleaner_removed_files $metric_files
# HELP tmpcleaner_removed_directories Number of directories removed in the last run.
# TYPE tmpcleaner_removed_directories gauge
tmpcleaner_removed_directories $metric_directories
# HELP tmpcleaner_removed_bytes Apparent size in bytes of non-directory entries observed removed in the last run.
# TYPE tmpcleaner_removed_bytes gauge
tmpcleaner_removed_bytes $metric_bytes
# HELP tmpcleaner_protected_paths Number of in-use /tmp paths the last run protected from cleanup.
# TYPE tmpcleaner_protected_paths gauge
tmpcleaner_protected_paths $metric_protected
# HELP tmpcleaner_marked_directories Number of /tmp directories .tmpcleaner-keep markers kept in the last run.
# TYPE tmpcleaner_marked_directories gauge
tmpcleaner_marked_directories $metric_marked
# HELP tmpcleaner_last_run_timestamp_seconds Unix timestamp of the last run completion.
# TYPE tmpcleaner_last_run_timestamp_seconds gauge
tmpcleaner_last_run_timestamp_seconds $now
# HELP tmpcleaner_last_success_timestamp_seconds Unix timestamp of the last run that exited 0.
# TYPE tmpcleaner_last_success_timestamp_seconds gauge
tmpcleaner_last_success_timestamp_seconds $last_success
# HELP tmpcleaner_last_exit_status Exit status of the last run.
# TYPE tmpcleaner_last_exit_status gauge
tmpcleaner_last_exit_status $exit_status
# HELP tmpcleaner_pressure_mode_active Whether the pressure age override was selected in the last run.
# TYPE tmpcleaner_pressure_mode_active gauge
tmpcleaner_pressure_mode_active $metric_pressure_active
# HELP tmpcleaner_last_run_duration_seconds Elapsed seconds from metrics initialization to publication.
# TYPE tmpcleaner_last_run_duration_seconds gauge
tmpcleaner_last_run_duration_seconds $metric_duration
EOF
	} 2>/dev/null; then
		:
	else
		rm -f "${mtmp:-}" 2>/dev/null || :
		echo "${warn_tag}tmpcleaner: cannot write metrics to $TMPCLEANER_METRICS" >&2
	fi
}
metric_files=0 metric_directories=0 metric_bytes=0 metric_protected=0 metric_marked=0 metric_pressure_active=0
metrics_ready=1
metric_started=
if [ "$previewing" = 0 ] && [ -n "${TMPCLEANER_METRICS:-}" ]; then
	read -r metric_started _ 2>/dev/null < /proc/uptime || metric_started=
fi

# A full /tmp may still hold a new directory but no data: when the default
# location cannot store a byte, retry once in /dev/shm before aborting.
scratch=$(mktemp -d 2>/dev/null) && { printf x > "$scratch/excludes"; } 2>/dev/null || {
	[ -z "$scratch" ] || rm -rf "$scratch"
	scratch=$(mktemp -d -p /dev/shm 2>/dev/null)
} || { echo "${err_tag}tmpcleaner: cannot create a scratch directory" >&2; exit "$errstatus"; }
printf '%s\0' "$scratch" > "$scratch/excludes"
add_exclusion() {
	path=$2
	while [ "$path" != / ] && [ "${path%/}" != "$path" ]; do path=${path%/}; done
	excl_shown=$(printf '%s' "$path" | LC_ALL=C tr '\001-\037\177' '[?*]')
	base=${path##*/}
	case "$base" in
		.|..) parent=$path base= ;;
		*) parent=${path%/*} ;;
	esac
	excl=$(realpath -m -- "${parent:-/}" 2>/dev/null && printf x) || {
		printf '%stmpcleaner: cannot canonicalize %s: %s\n' "$err_tag" "$1" "$excl_shown" >&2
		exit "$errstatus"
	}
	excl=${excl%x}
	excl=${excl%"$nl"}
	[ -z "$base" ] || excl=${excl%/}/$base
	case "$excl" in
		/tmp|/tmp/*) ;;
		*) printf '%stmpcleaner: %s must be under /tmp: %s\n' "$err_tag" "$1" "$excl_shown" >&2; exit "$errstatus" ;;
	esac
	printf '%s\0' "$excl" >> "$scratch/excludes"
}
if [ "$#" -gt 0 ]; then
	n=$#
	while [ "$n" -gt 0 ]; do
		arg=$1
		shift
		n=$((n - 1))
		case "$arg" in
			--exclude-prefix=*) add_exclusion --exclude-prefix "${arg#--exclude-prefix=}" ;;
			--exclude-from0=*)
				file=${arg#--exclude-from0=}
				# Validate a private copy so the file cannot change between the checks and the read.
				if [ ! -f "$file" ] || [ ! -r "$file" ] || ! cat 2>/dev/null < "$file" > "$scratch/exclude-from0"; then
					echo "${err_tag}tmpcleaner: --exclude-from0 requires a readable regular file: $file" >&2
					exit "$errstatus"
				fi
				case "$(tail -c 1 < "$scratch/exclude-from0" | od -An -tx1)" in
					''|*00) ;;
					*) echo "${err_tag}tmpcleaner: --exclude-from0 file ends with an unterminated record: $file" >&2; exit "$errstatus" ;;
				esac
				ERR_TAG=$err_tag LC_ALL=C awk '
					BEGIN { RS = "\0" }
					/[\n\r]/ {
						shown = $0
						gsub(/[\001-\037\177]/, "?", shown)
						print ENVIRON["ERR_TAG"] "tmpcleaner: --exclude-from0 cannot hold a path that contains a newline or carriage return: " shown > "/dev/stderr"
						exit 1
					}
				' "$scratch/exclude-from0" || exit "$errstatus"
				tr '\0' '\n' < "$scratch/exclude-from0" > "$scratch/exclude-from0-paths" || exit "$errstatus"
				while IFS= read -r record; do
					case "$record" in
						/*) ;;
						*)
							shown=$(printf '%s' "$record" | LC_ALL=C tr '\001-\037\177' '?')
							printf '%stmpcleaner: --exclude-from0 record must be an absolute path: %s\n' "$err_tag" "$shown" >&2
							exit "$errstatus"
							;;
					esac
					add_exclusion --exclude-from0 "$record"
				done < "$scratch/exclude-from0-paths"
				;;
			*) set -- "$@" "$arg" ;;
		esac
	done
fi
if [ -n "$check0" ]; then
	cat > "$scratch/check0-in" || exit 2
	ERR_TAG=$err_tag LC_ALL=C awk '
		BEGIN { RS = "\0" }
		/\n/ {
			shown = $0
			gsub(/[\001-\037\177]/, "?", shown)
			print ENVIRON["ERR_TAG"] "tmpcleaner: --check cannot match a path that contains a newline or carriage return: " shown > "/dev/stderr"
			exit 1
		}
	' "$scratch/check0-in" || exit 2
	tr '\0' '\n' < "$scratch/check0-in" > "$scratch/check0-paths" || exit 2
	check0_read=0
	while IFS= read -r requested || [ -n "$requested" ]; do
		canonicalize_check
		check0_read=1
	done < "$scratch/check0-paths"
	[ "$check0_read" = 1 ] || { echo "${err_tag}tmpcleaner: --check0 requires at least one path on stdin" >&2; exit 2; }
fi

tmp_age_rule() {
	LC_ALL=C awk '
		# The first line for /tmp wins; later duplicates are ignored by systemd-tmpfiles.
		# Boot-only (!) lines are skipped, and e lines form their own class.
		$1 ~ /^[dDeqQv][-!=~^+$?]*$/ && $1 !~ /!/ {
			if ($2 ~ /^"[^"]*"$/ || $2 ~ /^\047[^\047]*\047$/) path = substr($2, 2, length($2) - 2)
			else if ($2 !~ /["\047]/) path = $2
			else next
			sub(/\/+$/, "", path)
			if (path == "/tmp") {
				if (substr($1, 1, 1) == "e") {
					if (!seen_e++) {
						e_line = $0
						e_age = (NF >= 6 && $6 != "-")
					}
				} else if (!seen_own++) {
					own_line = $0
					own_age = (NF >= 6 && $6 != "-")
				}
			}
		}
		END {
			if (own_age) print own_line
			if (e_age) print e_line
		}
	' "$1"
}

dropins() {
	if [ -e "$conf.d" ] || [ -L "$conf.d" ]; then
		[ -d "$conf.d" ] && [ -r "$conf.d" ] && [ -x "$conf.d" ] || {
			echo "${err_tag}tmpcleaner: cannot read $conf.d" >&2
			exit "$errstatus"
		}
		saved_lc_all=${LC_ALL+x}:${LC_ALL-}
		LC_ALL=C
		for dropin in "$conf.d"/*.conf; do
			[ -e "$dropin" ] || [ -L "$dropin" ] || continue
			[ -d "$dropin" ] && continue
			[ -f "$dropin" ] && [ -r "$dropin" ] || {
				echo "${err_tag}tmpcleaner: cannot read $dropin" >&2
				exit "$errstatus"
			}
		done
		case "$saved_lc_all" in :*) unset LC_ALL ;; *) LC_ALL=${saved_lc_all#*:} ;; esac
	fi
}

conf=${TMPCLEANER_CONF:-/etc/tmpcleaner/tmpcleaner.conf}
{ [ -f "$conf" ] && [ -r "$conf" ]; } || { echo "${err_tag}tmpcleaner: cannot read $conf" >&2; exit "$errstatus"; }
dropins
case "${TMPCLEANER_LIST:-}" in
	''|1|top|nul) ;;
	*) echo "${err_tag}tmpcleaner: invalid TMPCLEANER_LIST (expected 1, top, nul or empty)" >&2; exit "$errstatus" ;;
esac
# Check the user's own value before pressure mode may replace it.
if [ "${TMPCLEANER_AGE+x}" ]; then
	printf '%s\0' "$TMPCLEANER_AGE" | LC_ALL=C grep -zEq '^[0-9]+(us|ms|s|m|min|h|d|w)?$' || {
		echo "${err_tag}tmpcleaner: invalid TMPCLEANER_AGE: $TMPCLEANER_AGE" >&2
		exit "$errstatus"
	}
fi
if [ "${TMPCLEANER_MARKER_AGE+x}" ]; then
	# Six digits keep -mmin within what find accepts; zero would expire every marker.
	printf '%s\0' "$TMPCLEANER_MARKER_AGE" | LC_ALL=C grep -zEq '^[0-9]{1,6}(m|min|h|d|w)$' &&
		! printf '%s\0' "$TMPCLEANER_MARKER_AGE" | LC_ALL=C grep -zEq '^0+[a-z]' || {
		echo "${err_tag}tmpcleaner: invalid TMPCLEANER_MARKER_AGE: $TMPCLEANER_MARKER_AGE" >&2
		exit "$errstatus"
	}
	marker_age_minutes=$(printf '%s\n' "$TMPCLEANER_MARKER_AGE" | LC_ALL=C awk '
		{
			minutes = $0 + 0
			sub(/^[0-9]+/, "")
			if ($0 == "h") minutes *= 60
			else if ($0 == "d") minutes *= 1440
			else if ($0 == "w") minutes *= 10080
			printf "%.0f", minutes
		}
	') || exit "$errstatus"
fi
if [ "${TMPCLEANER_FULL_PERCENT+x}" ]; then
	printf '%s\0' "$TMPCLEANER_FULL_PERCENT" | LC_ALL=C grep -zEq '^([1-9][0-9]?|100)$' || {
		echo "${err_tag}tmpcleaner: invalid TMPCLEANER_FULL_PERCENT: $TMPCLEANER_FULL_PERCENT" >&2
		exit "$errstatus"
	}
fi
if [ "${TMPCLEANER_FULL_AGE+x}" ]; then
	printf '%s\0' "$TMPCLEANER_FULL_AGE" | LC_ALL=C grep -zEq '^[0-9]+(us|ms|s|m|min|h|d|w)?$' || {
		echo "${err_tag}tmpcleaner: invalid TMPCLEANER_FULL_AGE: $TMPCLEANER_FULL_AGE" >&2
		exit "$errstatus"
	}
fi
if [ "${TMPCLEANER_FULL_PERCENT+x}" ] && [ "${TMPCLEANER_FULL_AGE+x}" ]; then
	dfout=$(df --output=pcent,ipcent /tmp) || { echo "${err_tag}tmpcleaner: cannot read /tmp usage" >&2; exit "$errstatus"; }
	usage_line=$(printf '%s\n' "$dfout" | sed -n '2p') || { echo "${err_tag}tmpcleaner: cannot read /tmp usage" >&2; exit "$errstatus"; }
	parsed=$(printf '%s\n' "$usage_line" | sed -n 's/^[[:space:]]*\([0-9][0-9]*\)%[[:space:]][[:space:]]*\([0-9][0-9]*%\|-\)[[:space:]]*$/\1 \2/p') || { echo "${err_tag}tmpcleaner: cannot read /tmp usage" >&2; exit "$errstatus"; }
	[ -n "$parsed" ] || { echo "${err_tag}tmpcleaner: cannot read /tmp usage" >&2; exit "$errstatus"; }
	block_use=${parsed% *}
	inode_use=${parsed#* }
	inode_use=${inode_use%\%}
	[ "$inode_use" != - ] || inode_use=0
	usage=$block_use
	[ "$inode_use" -le "$usage" ] || usage=$inode_use
	if [ "$usage" -ge "$TMPCLEANER_FULL_PERCENT" ]; then
		TMPCLEANER_AGE=$TMPCLEANER_FULL_AGE
		metric_pressure_active=1
		echo "tmpcleaner: /tmp is $usage% full (blocks $block_use%, inodes $inode_use%), using age $TMPCLEANER_AGE" >&2
	elif [ "$previewing" = 1 ]; then
		echo "tmpcleaner: /tmp is $usage% full (blocks $block_use%, inodes $inode_use%), below $TMPCLEANER_FULL_PERCENT%; keeping the configured age" >&2
	fi
elif [ "${TMPCLEANER_FULL_PERCENT+x}" ]; then
	echo "${warn_tag}tmpcleaner: pressure mode needs both TMPCLEANER_FULL_PERCENT and TMPCLEANER_FULL_AGE; ignoring TMPCLEANER_FULL_PERCENT" >&2
elif [ "${TMPCLEANER_FULL_AGE+x}" ]; then
	echo "${warn_tag}tmpcleaner: pressure mode needs both TMPCLEANER_FULL_PERCENT and TMPCLEANER_FULL_AGE; ignoring TMPCLEANER_FULL_AGE" >&2
fi

control_escapes=$(
	control=1
	while [ "$control" -le 31 ]; do
		printf 's/\\d%03d/\\\\x%02x/g\n' "$control" "$control"
		control=$((control + 1))
	done
	printf 's/\\d127/\\\\x7f/g\n'
)

# Without /proc no in-use file could be protected.
[ -e /proc/self/mountinfo ] || { echo "${err_tag}tmpcleaner: /proc is not available" >&2; exit "$errstatus"; }

# Match targets by device and inode: link texts can outlive their bind mounts.
# Every find and stat batch starts with a known-good target after a marker so
# awk can distinguish a tool failure from vanished-PID errors.
in_use() {
	tmpdev=$(stat -c %d /tmp) || return 1
	devhex=$(printf '%02x:%02x' "$(((tmpdev >> 8) & 0xfff))" "$(((tmpdev & 0xff) | ((tmpdev >> 12) & 0xfff00)))")
	# The builtin printf expands the globs without exec, so thousands of
	# processes never exceed ARG_MAX; xargs runs find in order on batches.
	# xargs exits 123 when a find or stat failed on a vanished /proc entry,
	# which is routine. 124 and up means a batch was killed or could not run,
	# so its records may stop after the sentinel: a "fail" pair (keeping the
	# pairing below) fails the scan.
	{
		printf '%s\0' /proc/[0-9]*/ns/mnt /proc/[0-9]*/root /proc/[0-9]*/ns/net |
			LC_ALL=C xargs -0 sh -c 'printf "/\0/\0"; exec find /proc/self/ns/mnt "$@" -maxdepth 0 -type l -printf "%p\0%l\0" 2>/dev/null' sh ||
			[ "$?" -lt 124 ] || printf 'fail\0fail\0'
		printf 'inodes\0'
		# One stat per target; a socket fd stats as a socket with the socket
		# inode. Cached attributes only: an fd on a hung network filesystem must
		# not stall the run.
		printf '%s\0' /proc/[0-9]*/root /proc/[0-9]*/exe /proc/[0-9]*/cwd /proc/[0-9]*/fd/* |
			LC_ALL=C xargs -0 sh -c 'printf "batch\0"; exec stat -L --cached=always --printf "%d %i %n %F\0" -- / "$@" 2>/dev/null' sh ||
			[ "$?" -lt 124 ] || printf 'fail\0fail\0'
	# POSIX leaves export of assignments before a function call unspecified.
	} | HOLDERS=$holders_file LC_ALL=C awk -v tmpdev="$tmpdev" -v devhex="$devhex" '
		BEGIN {
			RS = "\0"
		}
		function want(inode, holder) {
			if (inode ~ /^[0-9]+$/ && !(inode in wanted)) {
				wanted[inode] = 1
				nwanted++
			}
			if (holder ~ /^[0-9]+$/ && !((inode, holder) in seen_holder)) {
				seen_holder[inode, holder] = 1
				inode_holders[inode] = inode_holders[inode] ? inode_holders[inode] " " holder : holder
			}
		}
		function emit(path, inode) {
			gsub(/\/+/, "/", path)
			sub(/\/$/, "", path)
			if (path ~ /(^|\/)\.\.?($|\/)/) return
			if (index(path, "/tmp/") == 1 && length(path) > 5) {
				printf "%s%c", path, 0
				if (holders_file != "" && (inode in inode_holders))
					printf "%s%c%s%c", path, 0, inode_holders[inode], 0 > holders_file
			}
		}
		# Memory-mapped files come from the maps text: listing map_files makes the
		# kernel build an entry per mapping (tens of MB across all processes).
		function mapped(pid, file, line, saved) {
			file = "/proc/" pid "/maps"
			saved = RS
			RS = "\n"
			while ((getline line < file) > 0) {
				# Cheap pre-check, then the device field itself: a name may hold the text.
				if (!index(line, " " devhex " ")) continue
				split(line, fields, " ")
				if (fields[4] == devhex) want(fields[5], pid)
			}
			close(file)
			RS = saved
		}
		function tmpdirs(pid, file, line, path, args, queued, n, i, depth, parts, components, uid, saved, fields) {
			for (pid in rootlink) {
				file = "/proc/" pid "/status"
				saved = RS
				RS = "\n"
				uid = ""
				while ((getline line < file) > 0) {
					if (line !~ /^Uid:/) continue
					split(line, fields, " ")
					uid = fields[2]
					break
				}
				close(file)
				RS = saved
				if (uid !~ /^[0-9]+$/) continue
				file = "/proc/" pid "/environ"
				while ((getline line < file) > 0) {
					if (index(line, "TMPDIR=") != 1) continue
					path = substr(line, 8)
					gsub(/\/+/, "/", path)
					sub(/\/$/, "", path)
					if (index(path, "/tmp/") != 1) break
					# Check lexical scope without changing symlink/.. resolution by stat.
					n = split(path, parts, "/")
					depth = 0
					for (i = 1; i <= n; i++) {
						if (parts[i] == "" || parts[i] == ".") continue
						if (parts[i] == "..") {
							if (depth) depth--
						} else components[++depth] = parts[i]
					}
					if (depth > 1 && components[1] == "tmp") {
						path = "/proc/" pid "/root" path
						path_holder[path] = pid
						path_uid[path] = uid
						args = args " " quote(path)
						if (++queued >= 200) {
							verify(args, "directory")
							args = ""
							queued = 0
						}
					}
					break
				}
				close(file)
			}
			if (queued) verify(args, "directory")
		}
		# systemd-tmpfiles keeps only the sockets of its own network namespace;
		# a socket bound in another one is reached through /tmp all the same.
		# Names are printed raw, so a line that starts no record continues the
		# name before it; each name is resolved as every process holding the
		# socket sees it (one per mount namespace and root), and only a real
		# socket on /tmp is kept, so a forged record can keep no other file.
		function sockets(pid, file, line, n, k, inode, name, who, count, h, args, queued, saved, ns, path, real) {
			file = "/proc/" pid "/net/unix"
			saved = RS
			RS = "\n"
			if ((getline line < file) <= 0) {
				close(file)
				RS = saved
				return 0
			}
			while ((getline line < file) > 0) {
				if (line ~ /^ *[0-9a-fA-F]+: /) {
					split(line, fields, " ")
					inode[++n] = fields[7]
					name[n] = sub(/^ *[^ ]+ +[^ ]+ +[^ ]+ +[^ ]+ +[^ ]+ +[^ ]+ +[^ ]+ /, "", line) ? line : ""
				} else if (n) name[n] = name[n] "\n" line
			}
			close(file)
			RS = saved
			for (k = 1; k <= n; k++) {
				if (substr(name[k], 1, 1) != "/") continue
				real = (inode[k] in holders)
				count = split(real ? holders[inode[k]] : pid, who, " ")
				for (h = 1; h <= count; h++) {
					path = "/proc/" who[h] "/root" name[k]
					if (real) path_holder[path] = who[h]
					args = args " " quote(path)
					queued++
					# A socket may have been bound before its holder chrooted.
					ns = namespace[who[h]]
					path = ""
					if (ns == namespace["self"]) path = name[k]
					else if (ns in unconfined) path = "/proc/" unconfined[ns] "/root" name[k]
					if (path != "" && !((inode[k], ns) in unviewed)) {
						unviewed[inode[k], ns] = 1
						if (real && !(path in path_holder)) path_holder[path] = who[h]
						args = args " " quote(path)
						queued++
					}
					if (queued >= 200) {
						verify(args, "socket")
						args = ""
						queued = 0
					}
				}
			}
			if (queued) verify(args, "socket")
			return 1
		}
		# A shell word for s: single quotes, with each quote as '\''.
		function quote(s, parts, n, i, word) {
			n = split(s, parts, "\047")
			word = "\047" parts[1]
			for (i = 2; i <= n; i++) word = word "\047\\\047\047" parts[i]
			return word "\047"
		}
		# Keep matching entries on the /tmp filesystem among the quoted paths in
		# args (one stat for many: a process per name would cost seconds).
		function verify(args, type, cmd, line, saved, ok, status, path) {
			cmd = "stat -L --cached=always --printf \"%d %i %F %u %n\\0\" -- /" args " 2>/dev/null"
			saved = RS
			RS = "\0"
			while ((cmd | getline line) > 0) {
				if (!ok++) continue
				if (split(line, id, " ") >= 5 && id[1] == tmpdev && id[3] == type) {
					path = line
					sub(/^[^ ]+ +[^ ]+ +[^ ]+ +[^ ]+ /, "", path)
					if (type != "directory" || ((path in path_uid) && id[4] == path_uid[path]))
						want(id[2], path_holder[path])
				}
			}
			status = close(cmd)
			RS = saved
			# Status 1 is routine when a target vanishes or cannot be accessed.
			if (!ok || status < 0 || status > 1) failed = 1
		}
		$0 == "fail" { failed = 1; next }
		NR % 2 && $0 == "inodes" { inodes = 1; next }
		inodes {
			if ($0 == "batch") {
				if (expect) failed = 1
				expect = 1
				batches++
				next
			}
			if (expect) {
				if (split($0, id, " ") < 4 || id[3] != "/") failed = 1
				expect = 0
				next
			}
			if (split($0, id, " ") < 4) next
			if (id[1] == tmpdev) {
				split(id[3], parts, "/")
				want(id[2], parts[3])
			} else if ($0 ~ / socket$/ && split(id[3], parts, "/") == 5 && parts[4] == "fd") {
				pid = parts[3]
				view = namespace[pid] SUBSEP rootlink[pid]
				if (!((id[2], view) in viewed)) {
					viewed[id[2], view] = 1
					holders[id[2]] = holders[id[2]] " " pid
				}
			}
			next
		}
		NR % 2 {
			if ($0 == "/") {
				if (expect_ns) failed = 1
				expect_ns = 1
				# The second marker record must not reuse the fields of the last link.
				split("", parts)
				next
			}
			if (expect_ns) {
				if ($0 != "/proc/self/ns/mnt") failed = 1
				expect_ns = 0
			}
			split($0, parts, "/")
			pid = parts[3]
			next
		}
		parts[5] == "net" { netns[$0] = ($0 in netns) ? netns[$0] " " pid : pid; next }
		parts[4] == "ns" { namespace[pid] = $0; next }
		parts[4] == "root" {
			rootlink[pid] = $0
			if ($0 == "/") unconfined[namespace[pid]] = pid
			mapped(pid)
			next
		}
		# One walk of /tmp finds every file looked up by inode; a hard link
		# or bind alias only keeps another name of a file in use.
		END {
			if (failed || expect || expect_ns || !batches || !("self" in namespace)) exit 1
			if (ENVIRON["TMPCLEANER_PROTECT_TMPDIR"] == "1") tmpdirs()
			# A member may exit mid-scan: read the namespace through the next one. When
			# none is left, no process holds its sockets any more.
			for (ns in netns) {
				n = split(netns[ns], members, " ")
				for (i = 1; i <= n; i++) if (sockets(members[i])) break
			}
			if (failed) exit 1
			if (!nwanted) exit
			holders_file = ENVIRON["HOLDERS"]
			cmd = "find /tmp -xdev -printf \"%i %p\\0\" 2>/dev/null"
			while ((cmd | getline line) > 0) {
				n = index(line, " ")
				inode = substr(line, 1, n - 1)
				path = substr(line, n + 1)
				if (path == "/tmp") walked = 1
				if (inode in wanted) emit(path, inode)
			}
			status = close(cmd)
			if (!walked || status < 0 || status > 1) exit 1
		}'
}

escape_x_rules() {
	LC_ALL=C sed -z -e '/[[*?]/s/[][*?\\]/\\&/g' -e 's/[\\"]/\\&/g' \
		-e "$control_escapes" -e 's/%/%%/g' -e 's/.*/x "&"/' "$@"
}

rules() {
	dropins
	set -- "$conf"
	if [ -d "$conf.d" ]; then
		saved_lc_all=${LC_ALL+x}:${LC_ALL-}
		LC_ALL=C
		for dropin in "$conf.d"/*.conf; do
			[ -f "$dropin" ] && set -- "$@" "$dropin"
		done
		case "$saved_lc_all" in :*) unset LC_ALL ;; *) LC_ALL=${saved_lc_all#*:} ;; esac
	fi
	for cfgfile do
		if [ -n "$with_sources" ]; then
			cfg_source=$(printf '%s' "$cfgfile" | LC_ALL=C tr '\001-\037\177' '[?*]') || return 1
			printf '# source: %s\n' "$cfg_source" || return 1
		fi
		if [ "${TMPCLEANER_AGE+x}" ]; then
			# Replace the age (field 6) of d and D rules that have one, keeping any
			# age-by letters; rules without an age, and quoted paths holding
			# spaces (which cannot be split into fields safely), are left as is.
			# The closer must be the same quote that opened the field. A lone
			# quote is not closed (the "." requires a character before it).
			AGE=$TMPCLEANER_AGE ERR_TAG=$err_tag WARN_TAG=$warn_tag LC_ALL=C awk '
			{
				sub(/\015$/, "")
				if ($0 ~ /[\013\014\015]/) { print ENVIRON["ERR_TAG"] "tmpcleaner: raw CR, FF or VT in rule" > "/dev/stderr"; exit 1 }
			}
			$1 !~ /^[dD][-!=~^+$]*$/ { print; next }
			($2 ~ /^"/ && $2 !~ /.["]$/) || ($2 ~ /^\047/ && $2 !~ /.\047$/) { print ENVIRON["WARN_TAG"] "tmpcleaner: age override skipped for: " $0 > "/dev/stderr"; print; next }
			NF < 6 || $6 == "-" { print; next }
			{
				prefix = ""
				# Keep "~" (spares the immediate entries of a directory) and age-by letters.
				if (match($6, /^~?([abcmABCM]+:)?/)) prefix = substr($6, 1, RLENGTH)
				$6 = prefix ENVIRON["AGE"]
				print
			}' "$cfgfile" || return 1
		else
			cat "$cfgfile" || return 1
		fi
		echo
	done
	# Packages ship their own /tmp exclusions in tmpfiles.d (display-manager
	# X auth files, PrivateTmp). Keep the lines verbatim so specifiers and X
	# keep their meaning; skip a bare /tmp so no rule can exclude the whole tree.
	systemd-tmpfiles --cat-config > "$scratch/cat" || return 1
	WITH_SOURCES=$with_sources LC_ALL=C awk '
		/^# \/[^ ]*\.conf$/ {
			source = substr($0, 3)
			gsub(/[[:cntrl:]]/, "?", source)
			source_printed = 0
			next
		}
		$1 ~ /^[xX][!-]*$/ {
			if ($2 ~ /^"/ && match($0, /"[^"]*"/)) path = substr($0, RSTART + 1, RLENGTH - 2)
			else if ($2 ~ /^\047/ && match($0, /\047[^\047]*\047/)) path = substr($0, RSTART + 1, RLENGTH - 2)
			else path = $2
			gsub(/\/+/, "/", path)
			sub(/\/$/, "", path)
			if (index(path, "/tmp/") == 1 && length(path) > 5) {
				if (ENVIRON["WITH_SOURCES"] != "" && source != "" && !source_printed++) print "# source: " source
				print
			}
		}
	' "$scratch/cat" || return 1
	# File names are untrusted (any user can hold a file open), so each must
	# match only itself. NUL-separated, so a newline in a name cannot start a
	# new rule. tmpfiles treats a path with * ? [ as a glob: there, escape the
	# glob characters, or a file named "*" would exclude all of /tmp. Then
	# C-escape \ " and all control bytes for the quoted field and double % (specifier).
	# LC_ALL=C: names are bytes, not text. In a UTF-8 locale "." skips invalid
	# bytes, so a name holding one would leave its rule half quoted.
	[ -z "$check$export_holders" ] || holders_file=$scratch/holders
	in_use > "$scratch/inuse" || { scan_failed=1; return 1; }
	set --
	if [ "${TMPCLEANER_MARKER_AGE+x}" ]; then
		set -- -mmin "-$marker_age_minutes"
	fi
	find /tmp -xdev -mindepth 2 -maxdepth 3 -name .tmpcleaner-keep -type f "$@" -printf '%h\0' \
		> "$scratch/markers" 2>/dev/null || [ "$?" -eq 1 ] || return 1
	LC_ALL=C sort -zu "$scratch/inuse" "$scratch/markers" "$scratch/excludes" > "$scratch/sorted" || return 1
	escape_x_rules "$scratch/sorted" > "$scratch/excl" || return 1
	if [ -n "$with_sources" ]; then
		printf '# source: generated (in-use, markers, --exclude-prefix, --exclude-from0)\n' || return 1
	fi
	tr '\0' '\n' < "$scratch/excl" || return 1
}

generate_rules() {
	scan_failed=
	rules > "$scratch/rules" || {
		if [ "$scan_failed" = 1 ]; then
			echo "${err_tag}tmpcleaner: cannot scan processes in use; nothing was removed" >&2
		else
			echo "${err_tag}tmpcleaner: cannot generate cleanup rules; nothing was removed" >&2
		fi
		exit "$errstatus"
	}
	# An x rule cannot protect a root that another rule cleans directly.
	CHECKING=$check$check0 PROTECTED=$scratch/sorted ERR_TAG=$err_tag LC_ALL=C awk '
		function quote(s, parts, n, i, word) {
			n = split(s, parts, "\047")
			word = "\047" parts[1]
			for (i = 2; i <= n; i++) word = word "\047\\\047\047" parts[i]
			return word "\047"
		}
		function normalize(path, flags, cmd, saved, result, got, status) {
			cmd = "realpath " flags " -- " quote(path) " 2>/dev/null"
			saved = RS; RS = "\0"
			got = (cmd | getline result); status = close(cmd); RS = saved
			if (got != 1 || status != 0) failed = 1
			return result
		}
		function under(path, prefix) { return prefix == "/" || path == prefix || index(path, prefix "/") == 1 }
		function refuse(reason) {
			print ENVIRON["ERR_TAG"] "tmpcleaner: cannot safely interpret rule with in-use protection: " (reason ? reason ": " : "") $0 > "/dev/stderr"
			exit 1
		}
		BEGIN {
			RS = "\0"
			while ((got = (getline prefix < ENVIRON["PROTECTED"])) > 0) prefixes[++count] = prefix
			if (got < 0 || !count) refuse()
			close(ENVIRON["PROTECTED"]); RS = "\n"
			canonical_tmp = normalize("/tmp", "-ez")
			if (failed) refuse()
			if (canonical_tmp != "/tmp") refuse("/tmp must not be a symlink")
			while ((got = (getline line < "/proc/self/mountinfo")) > 0) {
				fields = split(line, mount, " "); separator = 0
				for (i = 7; i <= fields; i++) if (mount[i] == "-") { separator = i; break }
				if (line ~ /[\001-\037\177]/ || mount[1] !~ /^[0-9]+$/ || mount[2] !~ /^[0-9]+$/ ||
					mount[3] !~ /^[0-9]+:[0-9]+$/ ||
					(substr(mount[4], 1, 1) != "/" && mount[4] !~ /^[a-z_]+:\[[0-9]+\]$/) ||
					substr(mount[5], 1, 1) != "/" || separator < 7 ||
					!((fields == separator + 2 || fields == separator + 3) && line ~ / - [^ ]+ [^ ]* [^ ]+$/)) refuse("invalid mountinfo")
				point = mount[5]; encoded = point
				gsub(/\\(040|011|012|134)/, "", encoded)
				if (index(encoded, "\\")) refuse("invalid mountinfo path")
				gsub(/\\040/, " ", point); gsub(/\\011/, "\t", point); gsub(/\\012/, "\n", point)
				gsub(/\\134/, "\\", point)
				if (index(point, "/tmp/") == 1) mounts[++mount_count] = point
				records++
			}
			if (got < 0 || !records || close("/proc/self/mountinfo") != 0) refuse("cannot read mountinfo")
		}
		{
			sub(/\015$/, "")
			if ($0 ~ /[\013\014\015]/) refuse("raw CR, FF or VT in rule")
		}
		/^[[:space:]]*(#|$)/ { print; next }
		{
			rest = $0; sub(/^[[:space:]]*/, "", rest)
			type = substr(rest, 1, 1)
			if (type ~ /^[xX]$/) { print; next }
			sub(/^[^[:space:]]+[[:space:]]+/, "", rest)
			mark = substr(rest, 1, 1)
			if (mark == "\042" || mark == "\047") {
				end = index(substr(rest, 2), mark)
				if (!end || substr(rest, end + 2, 1) !~ /^[[:space:]]?$/) refuse()
				path = substr(rest, 2, end - 1)
			} else {
				match(rest, /^[^[:space:]]+/); path = substr(rest, 1, RLENGTH)
				if (path ~ /[\042\047]/) refuse()
			}
			specifiers = path; gsub(/%%/, "", specifiers)
			if (substr(path, 1, 1) != "/" || index(path, "\\") || index(specifiers, "%")) refuse()
			gsub(/%%/, "%", path)
			if (type !~ /^[dDvqQC]$/ && path ~ /[[*?]/) refuse()
			lexical = normalize(path, "-msz"); canonical = normalize(path, "-mz")
			if (failed) refuse()
			if (!under(lexical, "/tmp") || !under(canonical, canonical_tmp)) refuse("cleanup root is outside /tmp")
			for (i = 1; i <= mount_count; i++) if (under(canonical, mounts[i])) refuse("cleanup root crosses a nested /tmp mount")
			for (i = 1; i <= count; i++) if (under(lexical, prefixes[i]) || under(canonical, prefixes[i])) next
			if (ENVIRON["CHECKING"] != "" && path != canonical) refuse("noncanonical cleanup root in --check")
			print
		}' "$scratch/rules" > "$scratch/filtered" && mv "$scratch/filtered" "$scratch/rules" || {
		echo "${err_tag}tmpcleaner: cannot apply path protections; nothing was removed" >&2
		exit "$errstatus"
	}
	# A skipped keep rule would let the cleanup rule remove what it was meant to keep.
	LC_ALL=C awk '$1 ~ /^[xX]/' "$scratch/rules" > "$scratch/keep-rules" || {
		echo "${err_tag}tmpcleaner: cannot apply path protections; nothing was removed" >&2
		exit "$errstatus"
	}
	# A non-matching --prefix drops each line before mode, user, group and age
	# are checked. Status 73 with no <stdin>:N: line is an unprivileged open of
	# a root-only directory, not a bad keep rule.
	keep_status=0
	systemd-tmpfiles --clean - < "$scratch/keep-rules" 2> "$scratch/keep-errors" || keep_status=$?
	if [ "$keep_status" -eq 73 ] && ! grep -Eq '<stdin>:[0-9]+:' "$scratch/keep-errors"; then
		keep_status=0
	fi
	if [ "$keep_status" -ne 0 ]; then
		ERR_TAG=$err_tag LC_ALL=C awk '
			NR == FNR { lines[NR] = $0; next }
			match($0, /<stdin>:[0-9]+:/) {
				n = substr($0, RSTART + 8, RLENGTH - 9) + 0
				if (n in lines) {
					print ENVIRON["ERR_TAG"] "tmpcleaner: cannot parse exclusion rule: " lines[n]
					mapped = 1
				}
			}
			END { if (!mapped) exit 1 }
		' "$scratch/keep-rules" "$scratch/keep-errors" >&2 || cat "$scratch/keep-errors" >&2
		echo "${err_tag}tmpcleaner: an exclusion rule failed to parse; nothing was removed" >&2
		exit "$errstatus"
	fi
}

filter_in_use() {
	canonical_scratch=$(realpath -e -- "$scratch" 2>/dev/null && printf x) || {
		[ "$previewing" = 0 ] || echo "${err_tag}tmpcleaner: cannot canonicalize scratch directory" >&2
		return 1
	}
	canonical_scratch=${canonical_scratch%x}
	canonical_scratch=${canonical_scratch%"$nl"}
	SCRATCH=$scratch CANONICAL_SCRATCH=$canonical_scratch LC_ALL=C awk '
		BEGIN { RS = "\0"; lexical = ENVIRON["SCRATCH"]; canonical = ENVIRON["CANONICAL_SCRATCH"] }
		$0 != lexical && index($0, lexical "/") != 1 &&
		$0 != canonical && index($0, canonical "/") != 1 { printf "%s%c", $0, 0 }
	' "$scratch/inuse" > "$scratch/export" &&
		LC_ALL=C sort -zu "$scratch/export" > "$scratch/export-sorted" || {
		[ "$previewing" = 0 ] || echo "${err_tag}tmpcleaner: cannot export in-use paths" >&2
		return 1
	}
}

if [ "${1:-}" = --print-in-use0 ]; then
	generate_rules
	filter_in_use || exit 1
	cat "$scratch/export-sorted"
	exit
fi

if [ "${1:-}" = --print-holders0 ]; then
	generate_rules
	filter_in_use || exit 1
	[ ! -f "$scratch/holders" ] ||
		HOLDERS=$scratch/holders LC_ALL=C awk '
			BEGIN {
				RS = "\0"
				holders_file = ENVIRON["HOLDERS"]
				while ((getline hpath < holders_file) > 0 && (getline hpids < holders_file) > 0) {
					n = split(hpids, pid_list, " ")
					for (i = 1; i <= n; i++) {
						pid = pid_list[i]
						if (pid == "" || ((hpath, pid) in seen)) continue
						seen[hpath, pid] = 1
						pids[hpath] = (hpath in pids) ? pids[hpath] " " pid : pid
					}
				}
				close(holders_file)
			}
			$0 in pids { printf "%s%c%s%c", $0, 0, pids[$0], 0 }
		' "$scratch/export-sorted" > "$scratch/holders-sorted" || {
		echo "${err_tag}tmpcleaner: cannot export in-use holders" >&2
		exit 1
	}
	[ ! -f "$scratch/holders-sorted" ] || cat "$scratch/holders-sorted"
	exit
fi

if [ "${1:-}" = --print-rules ]; then
	generate_rules
	cat "$scratch/rules"
	exit 0
fi

check_entries() {
	# A directory goes only if everything beneath it goes too: the preview
	# announces old directories even when a kept entry will block the rmdir.
	# Preview lines are text a crafted name can forge, so errors may only lean
	# towards "would be removed" (a false alarm), never towards a false "kept":
	# a directory counts as removable once its lines cover all its entries, and
	# entries with newlines or carriage returns (their lines cannot be read) stop the check.
	dir=${check%/*}
	while [ -n "$dir" ]; do
		[ -r "$dir" ] || { echo "${err_tag}tmpcleaner: --check cannot read $shown" >&2; exit 2; }
		[ "$dir" = /tmp ] && break
		dir=${dir%/*}
	done
	entries=0
	if [ -d "$check" ] && [ ! -L "$check" ]; then
		if [ -n "$(find "$check" -mindepth 1 \( -name "*$nl*" -o -name "*$cr*" \) -print -quit 2>/dev/null)" ]; then
			echo "${err_tag}tmpcleaner: --check cannot judge a directory holding names with newlines or carriage returns${check0:+: $shown}" >&2
			exit 2
		fi
		entries=$(find "$check" -mindepth 1 -printf . 2>/dev/null) || {
			echo "${err_tag}tmpcleaner: --check cannot read $shown" >&2
			exit 2
		}
		entries=${#entries}
	fi
}

judge_check() {
	if [ -z "$check0" ]; then
		check_entries
		printf '%s\0%s\0%s\0' "$check" "$requested" "$entries" > "$scratch/check-entries" || exit 2
	fi
	verdict=0
	CHECK0=$check0 LC_ALL=C awk '
		FILENAME == ARGV[1] {
			if ($0 !~ /"$/) next
			if (index($0, "Would remove \"") == 1) {
				path = substr($0, 15, length($0) - 15)
				files[path] = 1
			} else if (index($0, "Would remove directory \"") == 1) {
				path = substr($0, 25, length($0) - 25)
				directories[path] = 1
			} else next
			# Count every preview line for each ancestor, including duplicate lines.
			while (sub(/\/[^/]*$/, "", path)) inside[path]++
			next
		}
		{
			path = $0
			if ((getline requested) != 1 || (getline entries) != 1) { failed = 1; exit 2 }
			removed = (path in files) || ((path in directories) && inside[path] >= entries + 0)
			if (ENVIRON["CHECK0"] != "") printf "%s%c%s%c", removed ? "removed" : "kept", 0, requested, 0
			if (!removed) any_kept = 1
		}
		END { if (!failed) exit any_kept }
		' "$scratch/preview" 'RS=\0' "$scratch/check-entries" > "$scratch/verdicts" || verdict=$?
}

if [ -n "$check$check0" ]; then
	generate_rules
	# 73: an unprivileged check cannot open root-only directories; the rest is valid.
	status=0
	# The parser reads info-level lines verbatim: a caller's log level, target
	# or line prefixes would hide them and turn every answer into "kept".
	preview=$(SYSTEMD_LOG_LEVEL=info SYSTEMD_LOG_TARGET=console SYSTEMD_LOG_COLOR=0 \
		SYSTEMD_LOG_LOCATION=0 SYSTEMD_LOG_TIME=0 SYSTEMD_LOG_TID=0 \
		systemd-tmpfiles --clean --dry-run - < "$scratch/rules" 2>&1) || status=$?
	if [ "$status" -ne 0 ] && [ "$status" -ne 73 ]; then
		printf '%s\n' "$preview" >&2
		exit "$errstatus"
	fi
	# A failed write is an error, not a verdict: only awk's 0 and 1 may answer.
	printf '%s\n' "$preview" > "$scratch/preview" || {
		echo "${err_tag}tmpcleaner: cannot write the --check scratch file" >&2
		exit "$errstatus"
	}
	if [ -n "$check0" ]; then
		: > "$scratch/check-entries" || exit 2
		while IFS= read -r requested || [ -n "$requested" ]; do
			canonicalize_check
			check_entries
			printf '%s\0%s\0%s\0' "$check" "$requested" "$entries" >> "$scratch/check-entries" || exit 2
		done < "$scratch/check0-paths"
		judge_check
		case "$verdict" in 0|1) ;; *) exit 2 ;; esac
		cat "$scratch/verdicts"
		exit "$verdict"
	fi
	judge_check
	case "$verdict" in
		0)
			printf 'would be removed: %s\n' "$shown"
			exit 0
			;;
		1)
			reason=$(CHECK=$check HOLDERS=$scratch/holders KEEP_RULES=$scratch/keep-rules SORTED=$scratch/sorted LC_ALL=C awk '
				function holders(target, holders_file, hpath, hpids, n, pid_list, i, pid, seen, shown_pids, comm_file, comm, who) {
					holders_file = ENVIRON["HOLDERS"]
					while ((getline hpath < holders_file) > 0 && (getline hpids < holders_file) > 0) {
						if (hpath == target) {
							n = split(hpids, pid_list, " ")
							for (i = 1; i <= n && shown_pids < 3; i++) {
								pid = pid_list[i]
								if (pid in seen) continue
								seen[pid] = 1
								comm_file = "/proc/" pid "/comm"
								comm = (getline comm < comm_file) > 0 ? comm : "?"
								close(comm_file)
								sub(/\n$/, "", comm)
								gsub(/[\001-\037\177]/, "?", comm)
								if (comm == "") comm = "?"
								who = who (shown_pids++ ? ", " : "") "PID " pid " (" comm ")"
							}
						}
					}
					close(holders_file)
					return who
				}
				# tmpfiles matches globs with fnmatch(FNM_PATHNAME | FNM_PERIOD): * ? and
				# [...] stay inside one component, and only a literal "." matches a
				# leading one. keep_rule passes only globs without escapes or classes.
				function glob_matches(glob, target, ere, n, i, c, j, end, set, g, t) {
					n = length(glob)
					for (i = 1; i <= n; i++) {
						c = substr(glob, i, 1)
						if (c == "*") { ere = ere "[^/]*"; continue }
						else if (c == "?") { ere = ere "[^/]"; continue }
						else if (c == "[") {
							j = i + 1
							if (substr(glob, j, 1) ~ /[!^]/) j++
							# A "]" right after the opener is a member, not the closer.
							end = index(substr(glob, j + 1), "]")
							if (end) {
								set = substr(glob, j, end)
								ere = ere (j > i + 1 ? "[^" set "/]" : "[" set "]")
								i = j + end
								continue
							}
						}
						ere = ere (index("\\.+*?()[]{}|^$", c) ? "\\" : "") c
					}
					if (target !~ "^" ere "$") return 0
					n = split(glob, g, "/"); split(target, t, "/")
					for (i = 1; i <= n; i++) if (substr(t[i], 1, 1) == "." && substr(g[i], 1, 1) != ".") return 0
					return 1
				}
				# The configured x/X rules open keep-rules; the generated ones, one per
				# in-use, marker or --exclude-prefix path, close it and are reported above.
				# x also keeps everything under a matched directory, X only the path.
				# Returns the candidate line number in keep-rules and its text; the caller
				# names it only if the preview without that line removes the path.
				function keep_rule(target, line, lines, total, generated, i, f, type, rule, p, s) {
					while ((getline line < ENVIRON["SORTED"]) > 0) generated++
					close(ENVIRON["SORTED"])
					RS = "\n"
					while ((getline line < ENVIRON["KEEP_RULES"]) > 0) lines[++total] = line
					close(ENVIRON["KEEP_RULES"]); RS = "\0"
					for (i = 1; i <= total - generated; i++) {
						split(lines[i], f)
						type = f[1]
						# x! applies only at boot; escapes, specifiers, ranges and [:class:]
						# or "/" sets are decoded by tmpfiles in ways this matcher does not copy.
						if (type !~ /^[xX][-=~^+$]*$/) continue
						if (f[2] ~ /^"/ && match(lines[i], /"[^"]*"/)) rule = substr(lines[i], RSTART + 1, RLENGTH - 2)
						else if (f[2] ~ /^\047/ && match(lines[i], /\047[^\047]*\047/)) rule = substr(lines[i], RSTART + 1, RLENGTH - 2)
						else rule = f[2]
						s = rule; gsub(/%%/, "", s)
						if (index(rule, "\\") || index(s, "%")) continue
						s = rule; gsub(/\[[!^]?[A-Za-z0-9_]+\]/, "", s)
						if (index(s, "[") || index(s, "]")) continue
						gsub(/\/+/, "/", rule)
						sub(/\/$/, "", rule)
						gsub(/%%/, "%", rule)
						for (p = target; p != ""; sub(/\/[^\/]*$/, "", p)) {
							if (glob_matches(rule, p)) {
								rule = type " " rule
								gsub(/[\001-\037\177]/, "?", rule)
								return i " " rule
							}
							if (type !~ /^x/) break
						}
					}
				}
				BEGIN {
					RS = "\0"
					path = ENVIRON["CHECK"]
					prefix = path "/"
				}
				FILENAME == ARGV[2] {
					if ($0 == path || $0 == "/" || index(path, $0 "/") == 1 ||
						(FNR > 1 && index($0, prefix) == 1)) excluded = 1
					next
				}
				FILENAME == ARGV[3] {
					if (marked == "" && ($0 == path || index(path, $0 "/") == 1 || index($0, prefix) == 1)) {
						marked = $0
						gsub(/[\001-\037\177]/, "?", marked)
					}
					next
				}
				$0 == path { exact = 1; exit }
				# A file name is untrusted: no control bytes reach the terminal.
				index($0, prefix) == 1 && held == "" { held_raw = held = $0; gsub(/[\001-\037\177]/, "?", held) }
				index(path, $0 "/") == 1 && ancestor == "" { ancestor_raw = ancestor = $0; gsub(/[\001-\037\177]/, "?", ancestor) }
				END {
					if (exact) {
						who = holders(path)
						print "tmpcleaner: in use by a running process" (who != "" ? ": " who : "")
					} else if (held != "") {
						who = holders(held_raw)
						print "tmpcleaner: holds an in-use path: " held (who != "" ? "; used by " who : "")
					} else if (ancestor != "") {
						who = holders(ancestor_raw)
						print "tmpcleaner: inside an in-use directory: " ancestor (who != "" ? "; used by " who : "")
					} else if (marked != "") print "tmpcleaner: kept by a .tmpcleaner-keep marker in " marked
					else if (excluded) print "tmpcleaner: kept by an explicit --exclude-prefix"
					else if ((rule = keep_rule(path)) != "") print rule
					else print "tmpcleaner: not old enough, or kept by a configuration rule"
				}
				' "$scratch/inuse" "$scratch/excludes" "$scratch/markers")
			case "$reason" in
				[0-9]*)
					# A matched rule keeps nothing if age alone keeps the path or tmpfiles
					# ignores the rule: name it only if the preview removes the path without it.
					LC_ALL=C awk -v n="${reason%% *}" '$1 ~ /^[xX]/ && ++i == n { next } 1' \
						"$scratch/rules" > "$scratch/rules-without" || exit 2
					without=$(SYSTEMD_LOG_LEVEL=info SYSTEMD_LOG_TARGET=console SYSTEMD_LOG_COLOR=0 \
						SYSTEMD_LOG_LOCATION=0 SYSTEMD_LOG_TIME=0 SYSTEMD_LOG_TID=0 \
						systemd-tmpfiles --clean --dry-run - < "$scratch/rules-without" 2>&1) ||
						[ "$?" -eq 73 ] || without=
					printf '%s\n' "$without" > "$scratch/preview" || exit 2
					judge_check
					if [ "$verdict" -eq 0 ]; then
						reason="tmpcleaner: kept by configuration rule: ${reason#* }"
					else
						reason='tmpcleaner: not old enough, or kept by a configuration rule'
					fi
					;;
			esac
			printf '%s\n' "$reason" >&2
			printf 'kept: %s\n' "$shown"
			exit 1
			;;
		*)
			exit 2
			;;
	esac
fi

breakdown_awk='
function track(path, rest, slash) {
	if (index(path, "/tmp/") != 1) return
	rest = substr(path, 6)
	if (rest == "") return
	slash = index(rest, "/")
	group[slash ? "/tmp/" substr(rest, 1, slash - 1) : path]++
}
function print_top(i, best, g, shown) {
	for (i = 1; i <= 10; i++) {
		best = ""
		for (g in group) {
			if (best == "" || group[g] > group[best] || (group[g] == group[best] && g < best)) best = g
		}
		if (best == "") break
		shown = best
		gsub(/[\001-\037\177]/, "?", shown)
		printf "tmpcleaner:   %d under %s\n", group[best], shown > "/dev/stderr"
		delete group[best]
	}
}'
if [ "${1:-}" = --suggest-exclusions ]; then
	generate_rules
	tmp_age_rule "$scratch/cat" | WARN_TAG=$warn_tag LC_ALL=C awk '
		{
			warn_tag = ENVIRON["WARN_TAG"]
			print warn_tag "tmpcleaner: systemd-tmpfiles-clean.timer still removes /tmp entries older than " $6 ", kept paths included: " $0 > "/dev/stderr"
		}
		END {
			if (NR) print warn_tag "tmpcleaner: /tmp is not long-term storage; keep anything that must outlive this age outside /tmp" > "/dev/stderr"
		}
	' || :
	status=0
	preview=$(SYSTEMD_LOG_LEVEL=info SYSTEMD_LOG_TARGET=console SYSTEMD_LOG_COLOR=0 \
		SYSTEMD_LOG_LOCATION=0 SYSTEMD_LOG_TIME=0 SYSTEMD_LOG_TID=0 \
		systemd-tmpfiles --clean --dry-run - < "$scratch/rules" 2>&1) || status=$?
	if [ "$status" -ne 0 ] && [ "$status" -ne 73 ]; then
		printf '%s\n' "$preview" >&2
		exit "$errstatus"
	fi
	printf '%s\n' "$preview" > "$scratch/preview" || {
		echo "${err_tag}tmpcleaner: cannot write the --suggest-exclusions scratch file" >&2
		exit "$errstatus"
	}
	COMMENTS=$scratch/suggest-comments PATHS=$scratch/suggest-paths LC_ALL=C awk "$breakdown_awk"'
	/^Would remove directory "/ && /"$/ { track(substr($0, 25, length($0) - 25)); next }
	/^Would remove "/ && /"$/ { track(substr($0, 15, length($0) - 15)); next }
	END {
		comments = ENVIRON["COMMENTS"]
		paths = ENVIRON["PATHS"]
		printf "" > comments
		printf "" > paths
		for (;;) {
			best = ""
			for (g in group) {
				if (best == "" || group[g] > group[best] || (group[g] == group[best] && g < best)) best = g
			}
			if (best == "") break
			shown = best
			gsub(/[\001-\037\177]/, "?", shown)
			printf "# %d entries would be removed under %s%c", group[best], shown, 0 > comments
			printf "%s%c", best, 0 > paths
			delete group[best]
		}
		if (close(comments) != 0 || close(paths) != 0) exit 1
	}
	' "$scratch/preview" &&
		escape_x_rules "$scratch/suggest-paths" > "$scratch/suggest-rules" &&
		COMMENTS=$scratch/suggest-comments RULES=$scratch/suggest-rules LC_ALL=C awk '
			BEGIN {
				RS = "\0"
				comments = ENVIRON["COMMENTS"]
				rules = ENVIRON["RULES"]
				while ((c = (getline comment < comments)) > 0) {
					if ((getline rule < rules) <= 0) exit 1
					printf "%s\n%s\n", comment, rule
				}
				if (c < 0 || (getline rule < rules) != 0 || close(comments) != 0 || close(rules) != 0) exit 1
			}
		' || {
		echo "${err_tag}tmpcleaner: cannot generate exclusion suggestions" >&2
		exit "$errstatus"
	}
	exit 0
fi
snapshot_roots() {
	# Snapshot every supported age-cleanup root (normally just /tmp).
	LC_ALL=C awk 'substr($1, 1, 1) ~ /^[dDevqQCrR]$/ {
		# A quoted root may hold spaces, so take everything between its quotes.
		if ($2 ~ /^"/ && match($0, /"[^"]*"/)) root = substr($0, RSTART + 1, RLENGTH - 2)
		else if ($2 ~ /^\047/ && match($0, /\047[^\047]*\047/)) root = substr($0, RSTART + 1, RLENGTH - 2)
		else root = $2
		gsub(/%%/, "%", root)
		print root
	}' \
		"$scratch/rules" > "$scratch/roots"
}
snapshot() {
	[ -z "${2:-}" ] || : > "$2"
	while IFS= read -r root; do
		# Keep overlapping walks identical without following root symlinks.
		root=$(realpath -ms -- "$root" 2>/dev/null) || continue
		if [ -n "${2:-}" ]; then
			: > "$scratch/root-sizes"
			find "$root" -xdev -samefile "$scratch" -prune -o -printf '%y %p\0' -fprintf "$scratch/root-sizes" '%s %y %p\0' 2>/dev/null || :
			cat "$scratch/root-sizes" >> "$2"
		else
			find "$root" -xdev -samefile "$scratch" -prune -o -printf '%y %p\0' 2>/dev/null || :
		fi
	done < "$scratch/roots" | LC_ALL=C sort -zu > "$1"
}
for arg do
	if [ "$arg" = --dry-run ]; then
		generate_rules
		snapshot_roots
		snapshot "$scratch/before" "$scratch/sizes"
		status=0
		# The summary reads info-level lines verbatim, as the --check preview does.
		SYSTEMD_LOG_LEVEL=info SYSTEMD_LOG_TARGET=console SYSTEMD_LOG_COLOR=0 \
			SYSTEMD_LOG_LOCATION=0 SYSTEMD_LOG_TIME=0 SYSTEMD_LOG_TID=0 \
			systemd-tmpfiles --clean "$@" - < "$scratch/rules" 2> "$scratch/stderr" || status=$?
		cat "$scratch/stderr" >&2
		# Preview lines are text a crafted name could inflate, so the count is an
		# estimate, like the --check preview parser.
		SIZES=$scratch/sizes LC_ALL=C awk "$breakdown_awk"'
		BEGIN {
			RS = "\0"
			sizes_file = ENVIRON["SIZES"]
			while ((getline record < sizes_file) > 0) {
				sep = index(record, " ")
				if (sep > 1 && substr(record, sep + 1, 1) != "d")
					sizes[substr(record, sep + 3)] = substr(record, 1, sep - 1) + 0
			}
			close(sizes_file)
			RS = "\n"
		}
		# Only a line that closes its quote names a whole path for the breakdown.
		/^Would remove directory "/ {
			directories++
			if (/"$/) track(substr($0, 25, length($0) - 25))
			next
		}
		/^Would remove "/ {
			files++
			if (/"$/) {
				path = substr($0, 15, length($0) - 15)
				# Overlapping rules announce one path once per rule.
				if (!(path in counted)) {
					counted[path] = 1
					bytes += sizes[path]
				}
				track(path)
			}
			next
		}
		END {
			printf "tmpcleaner: would remove %d files and %d directories (about %.0f bytes)\n", files, directories, bytes > "/dev/stderr"
			print_top()
		}
		' "$scratch/stderr"
		exit "$status"
	fi
done

# Count what the run removes by comparing NUL-separated snapshots taken
# before and after it. Names are never parsed out of systemd-tmpfiles' text,
# where a crafted name could forge or hide a record; the run itself logs
# natively to the journal. Entries another process deletes during the run are
# counted too. Scratch files sit in one private directory (mode 0700, random
# name) that the rules exclude and the snapshots skip.
generate_rules
if [ -n "${TMPCLEANER_METRICS:-}" ] && filter_in_use && protected=$(LC_ALL=C awk 'BEGIN { RS = "\0" } END { print NR + 0 }' "$scratch/export-sorted" 2>/dev/null); then
	metric_protected=$protected
fi
if [ -n "${TMPCLEANER_METRICS:-}" ] && marked=$(LC_ALL=C sort -zu "$scratch/markers" 2>/dev/null | LC_ALL=C awk 'BEGIN { RS = "\0" } END { print NR + 0 }' 2>/dev/null); then
	metric_marked=$marked
fi
snapshot_roots
sizes_file=
if [ -n "${TMPCLEANER_METRICS:-}" ]; then
	sizes_file=$scratch/sizes
	snapshot "$scratch/before" "$sizes_file"
else
	snapshot "$scratch/before"
fi

status=0
if [ "${TMPCLEANER_LIST:-}" = nul ]; then
	systemd-tmpfiles --clean "$@" - < "$scratch/rules" >&2 || status=$?
else
	systemd-tmpfiles --clean "$@" - < "$scratch/rules" || status=$?
fi

snapshot "$scratch/after"
LC_ALL=C comm -z -23 "$scratch/before" "$scratch/after" |
	COUNTS=$scratch/counts SIZES=$sizes_file SUMMARY=${TMPCLEANER_SUMMARY:-} LC_ALL=C awk -v list="${TMPCLEANER_LIST:-}" "$breakdown_awk"'
	BEGIN {
		RS = "\0"
		bytes = 0
		sizes_file = ENVIRON["SIZES"]
		if (sizes_file != "") {
			while ((getline record < sizes_file) > 0) {
				sep = index(record, " ")
				if (sep > 1) sizes[substr(record, sep + 1)] = substr(record, 1, sep - 1) + 0
			}
			close(sizes_file)
		}
		for (i = 1; i < 32; i++) escapes[sprintf("%c", i)] = sprintf("\\x%02x", i)
		escapes[sprintf("%c", 127)] = "\\x7f"
		escapes[sprintf("%c", 92)] = "\\x5c"
	}
	function escaped(path, i, byte, result) {
		for (i = 1; i <= length(path); i++) {
			byte = substr(path, i, 1)
			result = result (byte in escapes ? escapes[byte] : byte)
		}
		return result
	}
	{
		directory = (substr($0, 1, 1) == "d")
		if (directory) directories++
		else {
			files++
			bytes += sizes[$0]
		}
		path = substr($0, 3)
		track(path)
		if (list == 1) printf "tmpcleaner: removed%s: %s\n", directory ? " directory" : "", escaped(path) > "/dev/stderr"
		if (list == "nul") printf "%s%c", path, 0
	}
	END {
		if (ENVIRON["SUMMARY"] != "json")
			printf "tmpcleaner: %d files and %d directories disappeared during the run\n", files, directories > "/dev/stderr"
		if (list == "top") print_top()
		# -v would decode backslashes in the scratch path; ENVIRON keeps it raw.
		printf "%d %d %.0f\n", files, directories, bytes > ENVIRON["COUNTS"]
	}
	'
if read -r files directories bytes < "$scratch/counts" 2>/dev/null; then
	metric_files=$files metric_directories=$directories metric_bytes=$bytes
	if [ "$status" -eq 0 ]; then
		summary_files=$files summary_directories=$directories counts_available=true
	fi
fi
exit "$status"
