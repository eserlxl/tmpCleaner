#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Runs the /tmp age rules, but first excludes every /tmp path a running process
# holds open or uses as its working or root directory: systemd-tmpfiles only looks at
# timestamps, so a long-running job could otherwise lose files under its feet.
# Extra arguments (e.g. --dry-run) go to systemd-tmpfiles.
set -eu

case "${1:-}" in
	-h|--help)
		cat <<'EOF'
Usage: tmpcleaner [options]

Cleans /tmp using systemd-tmpfiles rules while protecting paths currently
in use by running processes.

Options:
  -h, --help       Show this help message and exit
  --print-rules    Print generated tmpfiles rules and exit

Other arguments (such as --dry-run) are passed to systemd-tmpfiles.

Environment variables:
  TMPCLEANER_CONF           Path to configuration file
                            (default: /etc/tmpcleaner/tmpcleaner.conf)
  TMPCLEANER_AGE            Override duration on every d rule (e.g. 6h, 30m)
  TMPCLEANER_FULL_PERCENT   Threshold percentage of /tmp usage (1-100)
  TMPCLEANER_FULL_AGE       Age duration to use when /tmp usage meets or
                            exceeds TMPCLEANER_FULL_PERCENT
EOF
		exit 0
		;;
esac

conf=${TMPCLEANER_CONF:-/etc/tmpcleaner/tmpcleaner.conf}
[ -r "$conf" ] || { echo "tmpcleaner: cannot read $conf" >&2; exit 1; }
# Check the user's own value before pressure mode may replace it.
if [ "${TMPCLEANER_AGE+x}" ]; then
	printf '%s\0' "$TMPCLEANER_AGE" | LC_ALL=C grep -zEq '^[0-9]+(us|ms|s|m|min|h|d|w)?$' || {
		echo "tmpcleaner: invalid TMPCLEANER_AGE: $TMPCLEANER_AGE" >&2
		exit 1
	}
fi
if [ "${TMPCLEANER_FULL_PERCENT+x}" ] && [ "${TMPCLEANER_FULL_AGE+x}" ]; then
	printf '%s\0' "$TMPCLEANER_FULL_PERCENT" | LC_ALL=C grep -zEq '^([1-9][0-9]?|100)$' || {
		echo "tmpcleaner: invalid TMPCLEANER_FULL_PERCENT: $TMPCLEANER_FULL_PERCENT" >&2
		exit 1
	}
	printf '%s\0' "$TMPCLEANER_FULL_AGE" | LC_ALL=C grep -zEq '^[0-9]+(us|ms|s|m|min|h|d|w)?$' || {
		echo "tmpcleaner: invalid TMPCLEANER_FULL_AGE: $TMPCLEANER_FULL_AGE" >&2
		exit 1
	}
	usage=$(df --output=pcent /tmp)
	usage=$(printf '%s\n' "$usage" | sed -n '2s/^[[:space:]]*\([0-9][0-9]*\)%$/\1/p')
	[ -n "$usage" ] || { echo "tmpcleaner: cannot read /tmp usage" >&2; exit 1; }
	if [ "$usage" -ge "$TMPCLEANER_FULL_PERCENT" ]; then
		TMPCLEANER_AGE=$TMPCLEANER_FULL_AGE
		echo "tmpcleaner: /tmp is $usage% full, using age $TMPCLEANER_AGE" >&2
	fi
fi

control_escapes=$(
	control=1
	while [ "$control" -le 31 ]; do
		printf 's/\\d%03d/\\\\x%02x/g\n' "$control" "$control"
		control=$((control + 1))
	done
	printf 's/\\d127/\\\\x7f/g\n'
)

# Targets of every process's exe, cwd, root, open fds and memory-mapped files. One find, not a readlink per fd:
# a busy desktop has tens of thousands of fds. Translate bind-mount aliases
# using the mount table matching the target, but never exclude /tmp itself.
in_use() {
	find /proc/self/ns/mnt /proc/[0-9]*/ns/mnt /proc/[0-9]*/exe /proc/[0-9]*/cwd /proc/[0-9]*/root /proc/[0-9]*/fd /proc/[0-9]*/map_files -maxdepth 1 -type l -printf '%p\0%l\0' 2>/dev/null |
		LC_ALL=C awk '
		function decode(path) {
			gsub(/\\040/, " ", path)
			gsub(/\\011/, "\t", path)
			gsub(/\\012/, "\n", path)
			gsub(/\\134/, sprintf("%c", 92), path)
			return path
		}
		function under(path, dir) {
			return dir == "/" || path == dir || index(path, dir "/") == 1
		}
		function suffix(path, dir) {
			return dir == "/" ? path : substr(path, length(dir) + 1)
		}
		function containing(pid, path, n, best, longest) {
			for (n = 1; n <= count[pid]; n++) {
				if (under(path, point[pid, n]) && length(point[pid, n]) >= longest) {
					longest = length(point[pid, n])
					best = n
				}
			}
			return best
		}
		function near(pid, path, k) {
			for (k = 1; k <= ntmp[pid]; k++) if (under(path, point[pid, tmpidx[pid, k]])) return 1
			return 0
		}
		function mounts(pid, file, line, fields, n) {
			if (pid in count) return
			count[pid] = 0
			file = "/proc/" pid "/mountinfo"
			RS = "\n"
			while ((getline line < file) > 0) {
				split(line, fields)
				n = ++count[pid]
				dev[pid, n] = fields[3]
				root[pid, n] = decode(fields[4])
				point[pid, n] = decode(fields[5])
				if (dev[pid, n] == device) tmpidx[pid, ++ntmp[pid]] = n
			}
			close(file)
			RS = "\0"
		}
		BEGIN {
			mounts("self")
			n = containing("self", "/tmp")
			device = dev["self", n]
			tmp_root = root["self", n]
			tmp_root = (tmp_root == "/" ? "" : tmp_root) suffix("/tmp", point["self", n])
			if (tmp_root == "") tmp_root = "/"
			# The device was unknown while "self" was read; list its /tmp-device mounts now.
			for (n = 1; n <= count["self"]; n++)
				if (dev["self", n] == device) tmpidx["self", ++ntmp["self"]] = n
		}
		NR % 2 { split($0, parts, "/"); pid = parts[3]; next }
		{
			if (parts[4] == "ns") { namespace[pid] = $0; next }
			if (substr($0, 1, 1) != "/" || device == "") next
			table = (namespace[pid] != "" && namespace[pid] == namespace["self"] ? "self" : pid)
			mounts(table)
			# Cheap pre-check: most targets lie on no mount of the /tmp filesystem.
			if (!near(table, $0)) next
			n = containing(table, $0)
			if (dev[table, n] != device) next
			path = (root[table, n] == "/" ? "" : root[table, n]) suffix($0, point[table, n])
			if (!under(path, tmp_root)) next
			path = "/tmp" suffix(path, tmp_root)
			gsub(/\/+/, "/", path)
			sub(/\/$/, "", path)
			if (path ~ /(^|\/)\.\.?($|\/)/) next
			if (index(path, "/tmp/") == 1 && length(path) > 5) printf "%s%c", path, 0
		}'
}

rules() {
	if [ "${TMPCLEANER_AGE+x}" ]; then
		# Replace the duration of the age field, keeping any age-by letters.
		sed -E "/^d[[:space:]]/s/[[:space:]]+([abcmABCM]+:)?[^[:space:]]*[[:space:]]*\$/ \\1$TMPCLEANER_AGE/" "$conf"
	else
		cat "$conf"
	fi
	echo
	# File names are untrusted (any user can hold a file open), so each must
	# match only itself. NUL-separated, so a newline in a name cannot start a
	# new rule. tmpfiles treats a path with * ? [ as a glob: there, escape the
	# glob characters, or a file named "*" would exclude all of /tmp. Then
	# C-escape \ " and all control bytes for the quoted field and double % (specifier).
	in_use | sort -zu |
		sed -z -e '/[[*?]/s/[][*?\\]/\\&/g' -e 's/[\\"]/\\&/g' \
			-e "$control_escapes" -e 's/%/%%/g' -e 's/.*/x "&"/' | tr '\0' '\n'
}

if [ "${1:-}" = --print-rules ]; then
	rules
	exit 0
fi

rules | systemd-tmpfiles --clean "$@" -
